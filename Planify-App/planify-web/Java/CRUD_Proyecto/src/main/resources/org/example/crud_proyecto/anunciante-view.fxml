<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="557.0" prefWidth="643.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.crud_proyecto.AnuncianteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label fx:id="PaginaAnuLabel" text="Anunciantes PLANIFY" textAlignment="CENTER">
        <font>
            <Font size="24.0" />
        </font>
    </Label>
    <TableView fx:id="TablaAnuId" prefHeight="400.0" prefWidth="432.0">
        <columns>
            <TableColumn fx:id="IdAnuncianteColumnaId" prefWidth="75.0" text="IdAnunciante" />
            <TableColumn fx:id="NombreAnuColumnaId" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="ContrasenaAnuColumnId" prefWidth="140.79998168945315" text="Contraseña" />
            <TableColumn fx:id="EmailAnuColumnId" prefWidth="177.60012817382812" text="Email" />
         <TableColumn fx:id="EmpresaColumnId" prefWidth="75.0" text="Empresa" />
         <TableColumn fx:id="PresupuestoColumnId" prefWidth="75.0" text="Presupuesto" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER">

        <Button fx:id="EditarAnuClickButton" mnemonicParsing="false" onAction="#EditarAnuOnActtion" text="Editar" textAlignment="CENTER">
            <HBox.margin>
                <Insets right="20.0" />
            </HBox.margin></Button>
        <Button fx:id="EliminarAnuClickButton" mnemonicParsing="false" onAction="#EliminarAnuOnAction" text="Eliminar" textAlignment="CENTER" />

    </HBox>
    <Label fx:id="MensajeLabelId" text="Label" />
    <TextField fx:id="NombreAnuTextField" promptText="Introduce un nombre.." />
    <TextField fx:id="EmailAnuTextField" layoutX="30.0" layoutY="302.0" promptText="Introduce un email..." />
    <TextField fx:id="ContrasenaAnuTextField" promptText="Introduce un contraseña..." />
   <TextField fx:id="EmpresaTextField" promptText="Introduce una empresa..." />
   <TextField fx:id="PresupuestoTextField" promptText="Introduce un presupuesto..." />

    <HBox alignment="CENTER">

        <Button fx:id="InsertarAnuClickButton" alignment="CENTER" onAction="#InsertarOnAction" text="Insertar" textAlignment="CENTER">
            <HBox.margin>
                <Insets right="20.0" />
            </HBox.margin></Button>
        <Button fx:id="GuardarAnuClickButton" alignment="CENTER" contentDisplay="CENTER" disable="true" mnemonicParsing="false" onAction="#GuardarOnAction" text="Guardar" textAlignment="CENTER" />

    </HBox>
   <Button fx:id="VolverAnuId" mnemonicParsing="false" onAction="#VolverAnuOnAction" text="Volver" />

</VBox>
