<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="557.0" prefWidth="554.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.crud_proyecto.UsuariosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label fx:id="PaginaLabel" text="Usuarios PLANIFY" textAlignment="CENTER">
        <font>
            <Font size="24.0" />
        </font>
    </Label>
    <TableView fx:id="TablaId" prefHeight="400.0" prefWidth="432.0">
        <columns>
            <TableColumn fx:id="IdUsuarioColumnaId" prefWidth="75.0" text="IdUsuario" />
            <TableColumn fx:id="NombreColumnaId" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="ContrasenaColumnId" prefWidth="140.79998168945315" text="Contraseña" />
         <TableColumn fx:id="EmailColumnId" prefWidth="177.60012817382812" text="Email" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER">

        <Button fx:id="EditarClickButton" mnemonicParsing="false" onAction="#EditarOnActtion" text="Editar" textAlignment="CENTER">
         <HBox.margin>
            <Insets right="20.0" />
         </HBox.margin></Button>
        <Button fx:id="EliminarClickButton" mnemonicParsing="false" onAction="#EliminarOnAction" text="Eliminar" textAlignment="CENTER" />

    </HBox>
   <Label fx:id="MensajeLabelId" text="Label" />
    <TextField fx:id="NombreTextField" promptText="Introduce un nombre.." />
   <TextField fx:id="EmailTextField" layoutX="30.0" layoutY="302.0" promptText="Introduce un email..." />
    <TextField fx:id="ContrasenaTextField" promptText="Introduce un contraseña..." />

    <HBox alignment="CENTER">

        <Button fx:id="InsertarClickButton" alignment="CENTER" onAction="#InsertarOnAction" text="Insertar" textAlignment="CENTER">
         <HBox.margin>
            <Insets right="20.0" />
         </HBox.margin></Button>
        <Button fx:id="GuardarClickButton" alignment="CENTER" contentDisplay="CENTER" disable="true" mnemonicParsing="false" onAction="#GuardarOnAction" text="Guardar" textAlignment="CENTER" />

    </HBox>
   <Button fx:id="VolverId" mnemonicParsing="false" onAction="#VolverOnAction" text="Volver" />

</VBox>
